# ==========================================
# MOSH AUTOMATION — Environment Configuration Template
# Copy this file to .env and replace placeholder values.
# NEVER commit .env with real credentials to version control.
# ==========================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Frontend Application Origin (Single URL or comma-separated list)
FRONTEND_URL=http://localhost:5173

# MySQL Database Configuration
# You can provide DATABASE_URL or individual DB parameters:
# DATABASE_URL=mysql://dbuser:dbpassword@localhost:3306/mosh_automation
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_secure_db_password_here
DB_NAME=mosh_automation

# JWT Authentication Secrets (Must be at least 32 characters in production)
JWT_SECRET=replace_with_a_cryptographically_secure_random_32_char_secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7

# Razorpay Payment Gateway (Test or Live keys from Razorpay dashboard)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here

# Optional: Fast2SMS / SMS Gateway for OTP verification
FAST2SMS_API_KEY=your_sms_api_key_here

# Optional: AI Chat Assistant Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite
AI_MODEL_API_URL=http://127.0.0.1:8000
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
